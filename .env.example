# Kanaka Sweets & Bakery - Environment Variables Example
# Required for production and local development.
# Only environment variable names are listed here (no secrets).

# Database (Supabase PostgreSQL, Mumbai ap-south-1)
# DATABASE_URL: Transaction pooler connection (port 6543, pgbouncer=true)
DATABASE_URL=
# DIRECT_URL: Direct session connection (port 5432) for migrations
DIRECT_URL=

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Used only by "pnpm create-admin" to make the admin account.
# Leave ADMIN_PASSWORD empty and the script generates one and saves it in .env
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Upstash Redis (Rate Limiting for Checkout and Admin)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary / Image Hosting (Optional for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public App URL
NEXT_PUBLIC_APP_URL=
